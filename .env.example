# Local development values only. Replace the example password before use.
# Use a URL-safe password here because Compose embeds it in DATABASE_URL.
POSTGRES_USER=prisoners
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=prisoners_dilemma
POSTGRES_PORT=5432
FRONTEND_ORIGINS=http://localhost:5173
# For a backend running on the host; Compose uses the db service hostname.
DATABASE_URL=postgresql+psycopg://prisoners:replace-with-a-local-password@localhost:5432/prisoners_dilemma
